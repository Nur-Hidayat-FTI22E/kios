# Salin file ini menjadi .env lalu isi nilai yang masih kosong.
#   cp .env.example .env
# File .env TIDAK boleh masuk git (sudah ada di .gitignore).

# --- WAJIB (tanpa ini container API menolak jalan) ---
# Rahasia JWT: hasilkan nilai acak kuat, mis. perintah: openssl rand -hex 32
JWT_SECRET=

# Password awal akun pemilik (username: pemilik). Ganti setelah login!
SEED_OWNER_PASSWORD=

# Password MySQL (dipakai db & api)
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# --- OPSI ---
# Zona waktu kasir (default Asia/Makassar=WITA)
APP_TZ=Asia/Makassar
# Origin web untuk CORS bila diakses dari domain lain (default http://localhost:80)
ALLOWED_ORIGIN=http://localhost:80
# Port host untuk web (default 80). Bila 80 dipakai, isi mis. 8080
WEB_PORT=80
